   "source": [
    "### 3.iv — How does the same type of experiment behave across model generations or platforms?\n",
    "\n",
    "Example: compare all configurations that share a `model_family` (e.g. all `GC31` runs, or all `EC-Earth3` runs) across different `HPC machine` / resolution tiers, to see how energy cost moves as the platform or generation changes for a *fixed* model lineage."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "4c1fd877",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 700x400 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "def plot_family_across_platforms(data, family, energy_col=\"energy_JPSY\", ax=None):\n",
    "    plot_df = data[data[\"model_family\"] == family].dropna(subset=[energy_col])\n",
    "    plot_df = plot_df.sort_values(energy_col)\n",
    "\n",
    "    if ax is None:\n",
    "        fig, ax = plt.subplots(figsize=(7, 4))\n",
    "\n",
    "    sns.scatterplot(data=plot_df, x=energy_col, y=\"HPC machine\", hue=\"Experiment Name\",\n",
    "                     s=120, ax=ax, legend=False)\n",
    "    for _, row in plot_df.iterrows():\n",
    "        ax.annotate(row[\"Experiment Name\"], (row[energy_col], row[\"HPC machine\"]),\n",
    "                    fontsize=8, xytext=(6, 0), textcoords=\"offset points\", va=\"center\")\n",
    "\n",
    "    ax.set_xscale(\"log\")\n",
    "    ax.set_xlabel(f\"{energy_col} (log scale)\")\n",
    "    ax.set_title(f\"'{family}' family: energy cost across experiments/platforms\")\n",
    "    return ax\n",
    "\n",
    "\n",
    "# Pick a family that spans more than one experiment as a worked example\n",
    "example_family = families_with_multiple[0] if families_with_multiple else df[\"model_family\"].iloc[0]\n",
    "plot_family_across_platforms(df, example_family)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
