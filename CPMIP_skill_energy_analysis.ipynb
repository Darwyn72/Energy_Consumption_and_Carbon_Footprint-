    "---\n",
    "## 1. Skill–energy diagrams\n",
    "\n",
    "The goal is to plot skill against an energy/cost metric **only within comparable groups**\n",
    "(e.g. the same `model_family`, or the same experiment type/resolution tier), since JPSY and\n",
    "CHSY are not directly comparable across very different model configurations.\n",
    "\n",
    "`plot_skill_energy` below:\n",
    "- filters to a chosen grouping value (or plots all groups faceted by colour if `group_value=None`),\n",
    "- uses a log-scaled energy axis (CPMIP energy metrics span orders of magnitude),\n",
    "- labels each point so individual configurations are identifiable."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "7fc9b58e",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 700x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "def plot_skill_energy(data, energy_col=\"energy_JPSY\", skill_col=SKILL_COL,\n",
    "                      group_col=\"model_family\", group_value=None,\n",
    "                      label_col=\"Experiment Name\", ax=None, title=None):\n",
    "    \"\"\"Scatter of skill vs. energy cost, restricted to a comparable group.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    group_value : str or None\n",
    "        If given, restrict to rows where group_col == group_value (a single, comparable\n",
    "        model class). If None, plot everything, coloured by group_col, for a first\n",
    "        exploratory look — treat cross-group comparisons with caution.\n",
    "    \"\"\"\n",
    "    plot_df = data.dropna(subset=[energy_col, skill_col])\n",
    "    if group_value is not None:\n",
    "        plot_df = plot_df[plot_df[group_col] == group_value]\n",
    "\n",
    "    if ax is None:\n",
    "        fig, ax = plt.subplots(figsize=(7, 5))\n",
    "\n",
    "    if group_value is None:\n",
    "        sns.scatterplot(data=plot_df, x=energy_col, y=skill_col, hue=group_col,\n",
    "                         s=90, ax=ax, palette=\"tab10\")\n",
    "        ax.legend(title=group_col, bbox_to_anchor=(1.02, 1), loc=\"upper left\", fontsize=8)\n",
    "    else:\n",
    "        sns.scatterplot(data=plot_df, x=energy_col, y=skill_col, s=100, ax=ax, color=\"steelblue\")\n",
    "\n",
    "    for _, row in plot_df.iterrows():\n",
    "        if label_col in row and pd.notna(row[label_col]):\n",
    "            ax.annotate(str(row[label_col]), (row[energy_col], row[skill_col]),\n",
    "                        fontsize=7, alpha=0.75, xytext=(4, 3), textcoords=\"offset points\")\n",
    "\n",
    "    ax.set_xscale(\"log\")\n",
    "    ax.set_xlabel(f\"{energy_col} (log scale)\")\n",
    "    ax.set_ylabel(skill_col)\n",
    "    ax.set_title(title or (f\"Skill vs. energy — {group_value}\" if group_value else\n",
    "                            \"Skill vs. energy — all model families (exploratory)\"))\n",
    "    return ax\n",
    "\n",
    "\n",
    "# Exploratory: all families together (colour-coded) — useful as a first look only\n",
    "plot_skill_energy(df, group_value=None)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
