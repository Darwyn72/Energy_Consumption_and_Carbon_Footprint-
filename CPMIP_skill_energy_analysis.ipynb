    "def pareto_frontier(data, energy_col=\"energy_JPSY\", skill_col=SKILL_COL):\n",
    "    \"\"\"Boolean mask: True where a row is not dominated by any other row\n",
    "    (i.e. no other row has both lower energy and equal-or-higher skill, with at\n",
    "    least one strict improvement).\"\"\"\n",
    "    d = data.dropna(subset=[energy_col, skill_col])\n",
    "    is_efficient = pd.Series(True, index=d.index)\n",
    "    for i, row in d.iterrows():\n",
    "        dominated_by = (\n",
    "            (d[energy_col] <= row[energy_col]) & (d[skill_col] >= row[skill_col]) &\n",
    "            ((d[energy_col] < row[energy_col]) | (d[skill_col] > row[skill_col]))\n",
    "        )\n",
    "        if dominated_by.any():\n",
    "            is_efficient[i] = False\n",
    "    return is_efficient.reindex(data.index, fill_value=False)\n",
    "\n",
    "\n",
    "def plot_efficiency_frontier(data, energy_col=\"energy_JPSY\", skill_col=SKILL_COL,\n",
    "                              group_col=\"model_family\", group_value=None,\n",
    "                              label_col=\"Experiment Name\", ax=None, title=None):\n",
    "    plot_df = data.dropna(subset=[energy_col, skill_col])\n",
    "    if group_value is not None:\n",
    "        plot_df = plot_df[plot_df[group_col] == group_value]\n",
    "\n",
    "    mask = pareto_frontier(plot_df, energy_col, skill_col)\n",
    "    frontier = plot_df[mask].sort_values(energy_col)\n",
    "\n",
    "    if ax is None:\n",
    "        fig, ax = plt.subplots(figsize=(7, 5))\n",
    "\n",
    "    sns.scatterplot(data=plot_df, x=energy_col, y=skill_col, ax=ax,\n",
    "                     color=\"lightgray\", s=70, label=\"dominated\")\n",
    "    sns.scatterplot(data=frontier, x=energy_col, y=skill_col, ax=ax,\n",
    "                     color=\"crimson\", s=110, label=\"efficiency frontier\", zorder=5)\n",
    "    ax.plot(frontier[energy_col], frontier[skill_col], color=\"crimson\", lw=1.5, alpha=0.6, zorder=4)\n",
    "\n",
    "    for _, row in frontier.iterrows():\n",
    "        if label_col in row and pd.notna(row[label_col]):\n",
    "            ax.annotate(str(row[label_col]), (row[energy_col], row[skill_col]),\n",
    "                        fontsize=7, xytext=(4, 3), textcoords=\"offset points\")\n",
    "\n",
    "    ax.set_xscale(\"log\")\n",
    "    ax.set_xlabel(f\"{energy_col} (log scale)\")\n",
    "    ax.set_ylabel(skill_col)\n",
    "    ax.legend(fontsize=8)\n",
    "    ax.set_title(title or f\"Efficiency frontier — {group_value or 'all configurations'}\")\n",
    "    return ax, frontier\n",
    "\n",
    "\n",
    "ax, frontier_all = plot_efficiency_frontier(df)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "frontier_all[[\"Institution\", \"Experiment Name\", \"model_family\", \"energy_JPSY\", SKILL_COL]]\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d704cb66",
   "metadata": {},
   "source": [
    "> As with the skill–energy diagrams, a frontier computed across **dissimilar model classes**\n",
    "> mixes apples and oranges. In practice you will usually want `plot_efficiency_frontier(df, group_value=<family>)`\n",
    "> — or first filter `df` to a genuinely comparable experiment type — before reading the frontier\n",
    "> as a real efficiency ranking."
   ]
  },
